# Gmail (IMAP). Create an app password at https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Only emails received on/after this date are pulled
GMAIL_START_DATE=2026-11-17
# Extra Gmail search filters
GMAIL_QUERY=-from:me -filename:ics -category:promotions -category:social
GMAIL_MAX_EMAILS=300

# Optional LLM for classification. Without a key, keyword matching is used.
# Presets: lyber (default when LYBER_API_KEY is set) or openai. LLM_BASE_URL / LLM_MODEL override the preset.
LYBER_API_KEY=
# LLM_PROVIDER=lyber
# LLM_MODEL=deepseek-v4.1-flash-1017-abliterated

# Encrypts docs/data.json; you type it to unlock the dashboard
DASHBOARD_PASSPHRASE=
